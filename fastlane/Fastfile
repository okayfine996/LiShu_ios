default_platform(:ios)

platform :ios do
  # 与 Xcode 工程一致：scheme LiShu、Automatic 签名
  desc "Archive Release 并导出 IPA（默认 app-store，可上传 TestFlight）"
  lane :ipa do |options|
    export_method = options[:export_method] || ENV["EXPORT_METHOD"] || "app-store"
    build_app(
      scheme: "LiShu",
      project: "./LiShu.xcodeproj",
      configuration: "Release",
      clean: true,
      export_method: export_method,
      output_directory: "./fastlane/build",
      output_name: "LiShu.ipa",
      # 允许 xcodebuild 在 Automatic 签名下更新描述文件（CLI/CI 常用）
      xcargs: "-allowProvisioningUpdates"
    )
  end

  # 等价于 fastlane 文档中的 capture_screenshots / snapshot
  desc "Generate App Store screenshots via UI tests（须命令行执行，见 docs.fastlane screenshots）"
  lane :screenshots do
    snapshot(
      scheme: "LiShu",
      project: "./LiShu.xcodeproj",
      test_target_name: "LiShuUITests",
      only_testing: ["LiShuUITests/AppStoreScreenshotTests"],
      derived_data_path: "./fastlane/DerivedData",
      output_directory: "./fastlane/screenshots",
      clear_previous_screenshots: true,
      # 自定义 SnapshotHelper（Swift 6 等）时勿改版本行；为防 fastlane 升级后误判，可跳过校验
      skip_helper_version_check: true,
      # 避免 Xcode 在「Clone N of Simulator」上跑 UI 测试时误启动 UITest bundle（FBSApplicationLibrary nil）
      xcargs: "-parallel-testing-enabled NO",
      # 内置 screenshots.html 依赖设备名白名单；实际设备见 Snapfile（当前为 iPhone 17 Pro Max + iOS 26.1）
      skip_open_summary: true
    )
    generate_lishu_screenshot_report
  end

  desc "仅根据 fastlane/screenshots 下已有 PNG 重写 screenshots.html（不调 snapshot；换机后也可补预览）"
  lane :screenshots_html do
    generate_lishu_screenshot_report
  end

  desc "仅为已有 *_framed.png 生成 framed.html（套壳+文案预览）"
  lane :framed_html do
    generate_lishu_framed_screenshot_report
  end

  desc "对 fastlane/screenshots 套设备壳并叠加标题（需已跑过 screenshots；依赖 ImageMagick）"
  lane :frameit do
    frame_screenshots(
      path: "./fastlane/screenshots"
    )
    generate_lishu_framed_screenshot_report
  end

  desc "先 snapshot 再 frameit，生成可上架风格的带壳+文案截图（产物为 *_framed.png）"
  lane :store_screenshots do
    screenshots
    frame_screenshots(path: "./fastlane/screenshots")
    generate_lishu_framed_screenshot_report
  end
end

# fastlane snapshot 的 ReportsGenerator 仅识别内置映射里的模拟器名；新机型不在列表中时
# screenshots.html 里没有任何 <img>。PNG 实际在 zh-Hans/ 下，此处在 snapshot 后重写可浏览的汇总页。
def generate_lishu_screenshot_report
  require "cgi"
  require "pathname"

  base = File.expand_path("screenshots", __dir__)
  pngs = Dir.glob(File.join(base, "**", "*.png")).sort
  if pngs.empty?
    UI.important("未在 #{base} 下找到 PNG，跳过截图预览页生成")
    return
  end

  rows = +<<~HTML
    <!DOCTYPE html>
    <html lang="zh-Hans">
    <head>
      <meta charset="UTF-8"/>
      <meta name="viewport" content="width=device-width, initial-scale=1"/>
      <title>LiShu 截图预览</title>
      <style>
        body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; padding: 16px; background: #f2f2f7; color: #1c1c1e; }
        h1 { font-size: 22px; }
        .note { font-size: 13px; color: #636366; margin-bottom: 24px; }
        h2 { font-size: 15px; margin: 28px 0 8px; }
        img { max-width: min(430px, 100%); height: auto; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,.08); }
        .path { font-size: 11px; color: #8e8e93; word-break: break-all; margin-bottom: 6px; }
      </style>
    </head>
    <body>
      <h1>LiShu 截图（snapshot）</h1>
      <p class="note">PNG 位于本目录下语言子文件夹（如 zh-Hans/）。若 fastlane 自带的截图报告页为空白，是因上游尚未把当前模拟器名加入设备映射表。</p>
    HTML

  pngs.each do |abs|
    rel = Pathname.new(abs).relative_path_from(Pathname.new(base)).to_s
    src = "./#{rel.tr('\\', '/')}"
    rows << "<h2>#{CGI.escapeHTML(rel)}</h2>\n"
    rows << "<div class=\"path\">#{CGI.escapeHTML(src)}</div>\n"
    rows << "<img src=\"#{CGI.escapeHTML(src)}\" alt=\"#{CGI.escapeHTML(rel)}\"/>\n"
  end
  rows << "</body></html>\n"

  out = File.join(base, "screenshots.html")
  File.write(out, rows)
  UI.success("截图预览页已写入：#{File.expand_path(out)}")
  if RUBY_PLATFORM.include?("darwin")
    system("open", File.expand_path(out))
  end
end

# 带设备壳与 title.strings / keyword.strings 文案的图：frameit 输出为「原名_framed.png」
def generate_lishu_framed_screenshot_report
  require "cgi"
  require "pathname"

  base = File.expand_path("screenshots", __dir__)
  pngs = Dir.glob(File.join(base, "**", "*_framed.png")).sort
  if pngs.empty?
    UI.important("未找到 *_framed.png。请先成功执行 fastlane ios frameit（首次会下载设备框，若 SSL 失败请重试）。")
    return
  end

  rows = +<<~HTML
    <!DOCTYPE html>
    <html lang="zh-Hans">
    <head>
      <meta charset="UTF-8"/>
      <meta name="viewport" content="width=device-width, initial-scale=1"/>
      <title>LiShu 套壳截图（含文案）</title>
      <style>
        body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; padding: 16px; background: #f2f2f7; color: #1c1c1e; }
        h1 { font-size: 22px; }
        .note { font-size: 13px; color: #636366; margin-bottom: 24px; }
        h2 { font-size: 15px; margin: 28px 0 8px; }
        img { max-width: min(520px, 100%); height: auto; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,.1); }
        .path { font-size: 11px; color: #8e8e93; word-break: break-all; margin-bottom: 6px; }
      </style>
    </head>
    <body>
      <h1>LiShu 套壳截图（frameit）</h1>
      <p class="note">文案来自 zh-Hans/title.strings 与 keyword.strings；修改后重新执行 <code>fastlane ios frameit</code>。</p>
    HTML

  pngs.each do |abs|
    rel = Pathname.new(abs).relative_path_from(Pathname.new(base)).to_s
    src = "./#{rel.tr('\\', '/')}"
    rows << "<h2>#{CGI.escapeHTML(rel)}</h2>\n"
    rows << "<div class=\"path\">#{CGI.escapeHTML(src)}</div>\n"
    rows << "<img src=\"#{CGI.escapeHTML(src)}\" alt=\"#{CGI.escapeHTML(rel)}\"/>\n"
  end
  rows << "</body></html>\n"

  out = File.join(base, "framed.html")
  File.write(out, rows)
  UI.success("套壳截图预览页已写入：#{File.expand_path(out)}")
  if RUBY_PLATFORM.include?("darwin")
    system("open", File.expand_path(out))
  end
end
